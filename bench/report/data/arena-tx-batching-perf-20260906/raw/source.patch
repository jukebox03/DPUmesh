+        size_t n = bufs[i].len < limit - offered ? bufs[i].len : limit - offered;
+        offered += n;
+        if (offered == limit) break;
+    }
+    if (!offered) return 0;
+    struct px_chunk *ch = NULL;
+    if (*token) {
